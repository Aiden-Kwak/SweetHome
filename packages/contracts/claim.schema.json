{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policymap.local/contracts/claim.schema.json",
  "title": "Claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "policy_type",
    "target_region",
    "sample_period",
    "outcome_metric",
    "effect_direction",
    "effect_value",
    "lower_bound",
    "upper_bound",
    "unit",
    "horizon_months",
    "method",
    "market_regime",
    "evidence_grade",
    "limitations",
    "source"
  ],
  "properties": {
    "claim_id": { "type": "string" },
    "evidence_id": { "type": "string" },
    "title": { "type": "string" },
    "policy_type": { "type": "string" },
    "target_region": { "type": "string" },
    "sample_period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date" },
        "end": { "type": "string", "format": "date" }
      }
    },
    "outcome_metric": { "type": "string" },
    "effect_direction": {
      "enum": ["increase", "decrease", "neutral", "mixed", "unknown"]
    },
    "effect_semantics": {
      "type": ["string", "null"]
    },
    "effect_value": { "type": ["number", "null"] },
    "lower_bound": { "type": ["number", "null"] },
    "upper_bound": { "type": ["number", "null"] },
    "unit": { "type": ["string", "null"] },
    "horizon_months": { "type": ["integer", "null"], "minimum": 0 },
    "horizon_class": {
      "enum": [
        "immediate",
        "short_to_medium_run",
        "long_run_equilibrium",
        "dynamic_path",
        "unknown"
      ]
    },
    "is_quantitative_candidate": { "type": "boolean" },
    "scenario_match": {
      "enum": ["MATCHED", "PARTIAL_MATCH", "DIFFERENT_REGIME"]
    },
    "method": { "type": "string" },
    "market_regime": { "type": "string" },
    "evidence_grade": { "enum": ["A", "B", "C", "D"] },
    "mechanisms": {
      "type": "array",
      "items": { "type": "string" }
    },
    "related_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "relation"],
        "properties": {
          "claim_id": { "type": "string" },
          "relation": {
            "enum": ["CONFLICTS_WITH", "COMPLEMENTS", "CONTEXTUALIZES"]
          },
          "reason": { "type": ["string", "null"] }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "publisher", "url"],
      "properties": {
        "title": { "type": "string" },
        "publisher": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "published_at": { "type": ["string", "null"] },
        "series": { "type": ["string", "null"] },
        "source_type": { "type": ["string", "null"] },
        "review_status": { "type": ["string", "null"] },
        "locator": { "type": ["string", "null"] }
      }
    }
  }
}
